# Copy this file to .env and fill in your values

# Get this from @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Your group's chat ID (negative number for groups, e.g. -1001234567890)
# See README "Step 2" for how to find this
TELEGRAM_CHAT_ID=-1001234567890

# How often to check, in minutes (default 45)
POLL_INTERVAL_MINUTES=45

# Set to 1 to save screenshots + raw portal responses into ./debug
DEBUG_SCRAPER=0
